{
  "name": "ecotrace-kiroween",
  "private": true,
  "version": "1.1.0",
  "description": "Shipping carbon auditor for e-commerce: a shared foundation with a CLI and a webhook dashboard built on it.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mintellegence/ecotrace-cli.git"
  },
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx apps/ecotrace-web/server.ts",
    "start": "tsx apps/ecotrace-web/server.ts",
    "build": "vite build --config apps/ecotrace-web/vite.config.ts",
    "cli": "tsx apps/ecotrace-cli/bin/ecotrace.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm test && npm run build",
    "verify:local": "tsx apps/ecotrace-cli/bin/ecotrace.ts verify http://127.0.0.1:3000",
    "verify:live": "tsx apps/ecotrace-cli/bin/ecotrace.ts verify https://ecotrace-cli.onrender.com"
  },
  "dependencies": {
    "commander": "15.1.0",
    "express": "4.22.3",
    "lucide-react": "0.577.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fast-check": "4.10.3",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
