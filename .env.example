# Copy to .env and fill in what you need. Never commit .env (it is git-ignored).
# Every variable is optional for local development.

# --- Warehouse / ship-from location -------------------------------------
# Store webhooks do not include where the parcel ships from, so set it here.
# Exact coordinates give the most accurate distances.
ECOTRACE_ORIGIN_CITY=Memphis
ECOTRACE_ORIGIN_STATE=TN
ECOTRACE_ORIGIN_COUNTRY=US
ECOTRACE_ORIGIN_LAT=
ECOTRACE_ORIGIN_LNG=

# --- Web app ------------------------------------------------------------
# true  = seed sample orders, allow reset, keep data in memory only (public demo)
# false = real ledger, persisted to ECOTRACE_LEDGER_FILE
ECOTRACE_DEMO_MODE=true
ECOTRACE_LEDGER_FILE=.ecotrace/ledger.json
PORT=3000

# Protect the dashboard/ledger API with a bearer token (recommended for real data).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ECOTRACE_READ_TOKEN=
# Required to reset the ledger outside demo mode.
ECOTRACE_ADMIN_TOKEN=

# --- Store webhooks (HMAC signing secrets) --------------------------------
# Shopify: Settings > Notifications > Webhooks, "Your webhooks will be signed with ..."
SHOPIFY_WEBHOOK_SECRET=
# WooCommerce: Settings > Advanced > Webhooks > Secret
WOOCOMMERCE_WEBHOOK_SECRET=
# Local development only: accept unsigned webhooks. Ignored when NODE_ENV=production.
ECOTRACE_ALLOW_UNSIGNED_WEBHOOKS=false

# --- CLI live commands ----------------------------------------------------
# Default server for `send-webhook` and `verify`.
ECOTRACE_URL=http://127.0.0.1:3000
